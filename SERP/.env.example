# SERP Analyzer Environment Variables
# Copy this file to .env and fill in your actual values

# Semantic Scholar API Key
# Get your key from: https://www.semanticscholar.org/product/api
S2_API_KEY=your_api_key_here

# Use mock data instead of real API calls (useful for testing)
# Set to "true" to use mock data, or "false" to use real API
USE_MOCK_DATA=true
